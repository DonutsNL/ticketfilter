<div class="simulator-tab-content">
    <div class="row">
        <!-- Ad-Hoc Sample Tester Card -->
        <div class="col-lg-6 mb-3">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-vial text-muted me-2"></i>{{ __('Single email tester', 'ticketfilter') }}
                    </h5>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="regexPresetsBtn" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-magic me-1"></i>{{ __('Regex presets', 'ticketfilter') }}
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="regexPresetsBtn">
                            <li><button type="button" class="dropdown-item" data-preset="jira">Jira: <code>(?&lt;match&gt;[A-Z]+-[0-9]+)</code></button></li>
                            <li><button type="button" class="dropdown-item" data-preset="github">GitHub / GitLab: <code>(?&lt;match&gt;#[0-9]+)</code></button></li>
                            <li><button type="button" class="dropdown-item" data-preset="servicenow">ServiceNow: <code>(?&lt;match&gt;INC[0-9]{7})</code></button></li>
                            <li><button type="button" class="dropdown-item" data-preset="bracket">Bracketed: <code>\[(?&lt;match&gt;[^\]]+)\]</code></button></li>
                        </ul>
                    </div>
                </div>
                <div class="card-body">
                    <form id="sampleSimulatorForm">
                        {% if csrf_token %}
                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
                        {% endif %}
                        <div class="mb-3">
                            <label class="form-label d-flex align-items-center" for="simPattern">
                                <span>{{ __('Ticket identifier pattern (regex)', 'ticketfilter') }} <span class="text-danger">*</span></span>
                                <span class="form-help ms-1" tabindex="0" data-bs-toggle="popover" data-bs-placement="top" data-bs-html="true" data-bs-title="{{ __('Help', 'ticketfilter') }}" data-bs-content="{{ __('Expression used to extract the ticket ID from incoming email subjects or bodies. The regex must include the named capture group (?&lt;match&gt;...).', 'ticketfilter') }}">?</span>
                            </label>
                            <input type="text" class="form-control font-monospace" id="simPattern" placeholder="/.*?(?<match>\(JIRA-[0-9]+\)).*/i" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="simSubject">{{ __('Sample email subject', 'ticketfilter') }} <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="simSubject" placeholder="Re: (JIRA-1042) Database cluster outage update" required>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="simSender">{{ __('Sample sender email', 'ticketfilter') }}</label>
                                <input type="email" class="form-control" id="simSender" placeholder="engineer@domain.com">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label d-flex align-items-center" for="simSolvedPattern">
                                    <span>{{ __('Auto-solve keyword pattern (optional)', 'ticketfilter') }}</span>
                                    <span class="form-help ms-1" tabindex="0" data-bs-toggle="popover" data-bs-placement="top" data-bs-html="true" data-bs-title="{{ __('Help', 'ticketfilter') }}" data-bs-content="{{ __('Optional regular expression to test automatic ticket resolution when a matching keyword is found in the email subject. Must include (?&lt;solved&gt;...).', 'ticketfilter') }}">?</span>
                                </label>
                                <input type="text" class="form-control font-monospace" id="simSolvedPattern" placeholder="/.*?(?<solved>Closed|Resolved).*/i">
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-sm" id="btnRunSampleTest">
                            <i class="fas fa-play me-1"></i> {{ __('Test pattern', 'ticketfilter') }}
                        </button>
                    </form>

                    <!-- Ad-Hoc Output -->
                    <div id="sampleSimResult" class="mt-4" style="display: none;">
                        <h6 class="border-bottom pb-2 mb-3">{{ __('Test results', 'ticketfilter') }}</h6>
                        <div id="sampleSimBadge" class="mb-3"></div>
                        <div class="border rounded p-3">
                            <dl class="row mb-0 small">
                                <dt class="col-sm-4 text-muted">{{ __('Pattern valid:', 'ticketfilter') }}</dt>
                                <dd class="col-sm-8" id="resPatternValid">-</dd>
                                <dt class="col-sm-4 text-muted">{{ __('Extracted ticket ID:', 'ticketfilter') }}</dt>
                                <dd class="col-sm-8" id="resMatchedToken">-</dd>
                                <dt class="col-sm-4 text-muted">{{ __('Matching ticket in GLPI:', 'ticketfilter') }}</dt>
                                <dd class="col-sm-8" id="resTargetTickets">-</dd>
                                <dt class="col-sm-4 text-muted">{{ __('Resulting action:', 'ticketfilter') }}</dt>
                                <dd class="col-sm-8 fw-semibold" id="resSimulatedAction">-</dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Historical Batch Simulator Card -->
        <div class="col-lg-6 mb-3">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-history text-muted me-2"></i>{{ __('Existing tickets tester', 'ticketfilter') }}
                    </h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        {{ __('Test how a pattern matches existing tickets in your database to verify matches and check for duplicates or collisions.', 'ticketfilter') }}
                    </p>

                    <form id="historicalSimulatorForm">
                        {% if csrf_token %}
                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
                        {% endif %}
                        <div class="mb-3">
                            <label class="form-label d-flex align-items-center" for="histPattern">
                                <span>{{ __('Ticket identifier pattern (regex)', 'ticketfilter') }} <span class="text-danger">*</span></span>
                                <span class="form-help ms-1" tabindex="0" data-bs-toggle="popover" data-bs-placement="top" data-bs-html="true" data-bs-title="{{ __('Help', 'ticketfilter') }}" data-bs-content="{{ __('Expression used to scan existing ticket titles in GLPI to find matches and check for collisions.', 'ticketfilter') }}">?</span>
                            </label>
                            <input type="text" class="form-control font-monospace" id="histPattern" placeholder="/.*?(?<match>\(JIRA-[0-9]+\)).*/i" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label d-flex align-items-center" for="histLimit">
                                <span>{{ __('Recent tickets to scan', 'ticketfilter') }}</span>
                                <span class="form-help ms-1" tabindex="0" data-bs-toggle="popover" data-bs-placement="top" data-bs-html="true" data-bs-title="{{ __('Help', 'ticketfilter') }}" data-bs-content="{{ __('Select how many recent tickets from the database to evaluate in the dry-run scan.', 'ticketfilter') }}">?</span>
                            </label>
                            <select class="form-select form-select-sm" id="histLimit">
                                <option value="25">25 {{ __('tickets', 'ticketfilter') }}</option>
                                <option value="50" selected>50 {{ __('tickets', 'ticketfilter') }}</option>
                                <option value="100">100 {{ __('tickets', 'ticketfilter') }}</option>
                                <option value="200">200 {{ __('tickets', 'ticketfilter') }}</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-primary btn-sm" id="btnRunHistTest">
                            <i class="fas fa-search me-1"></i> {{ __('Run scan on existing tickets', 'ticketfilter') }}
                        </button>
                    </form>

                    <!-- Historical Output -->
                    <div id="historicalSimResult" class="mt-4" style="display: none;">
                        <h6 class="border-bottom pb-2 mb-3">{{ __('Scan summary', 'ticketfilter') }}</h6>
                        <div class="row g-2 mb-3 text-center">
                            <div class="col-4">
                                <div class="p-2 border rounded">
                                    <div class="text-muted small">{{ __('Scanned', 'ticketfilter') }}</div>
                                    <h4 class="mb-0 fw-semibold" id="histScannedCount">0</h4>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 border rounded">
                                    <div class="text-muted small">{{ __('Matched', 'ticketfilter') }}</div>
                                    <h4 class="mb-0 fw-semibold" id="histMatchedCount">0</h4>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 border rounded">
                                    <div class="text-muted small">{{ __('Collisions', 'ticketfilter') }}</div>
                                    <h4 class="mb-0 fw-semibold" id="histCollisionCount">0</h4>
                                </div>
                            </div>
                        </div>

                        <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
                            <table class="table table-sm table-hover align-middle mb-0" id="histMatchesTable">
                                <thead>
                                    <tr>
                                        <th style="width: 80px;">{{ __('Ticket', 'ticketfilter') }}</th>
                                        <th>{{ __('Ticket title', 'ticketfilter') }}</th>
                                        <th>{{ __('Extracted ID', 'ticketfilter') }}</th>
                                        <th style="width: 90px;">{{ __('Status', 'ticketfilter') }}</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
(function() {
    var simLabels = {
        testBtn: {{ __('Test pattern', 'ticketfilter')|json_encode|raw }},
        testingBtn: {{ __('Testing...', 'ticketfilter')|json_encode|raw }},
        scanBtn: {{ __('Run scan on existing tickets', 'ticketfilter')|json_encode|raw }},
        scanningBtn: {{ __('Scanning...', 'ticketfilter')|json_encode|raw }},
        forbidden403: {{ __('Access denied / Forbidden (HTTP 403). Please verify CSRF token and permissions.', 'ticketfilter')|json_encode|raw }}
    };

    function setSimulatorButtonContent(btn, iconClass, labelText) {
        if (!btn) return;
        var icon = document.createElement('i');
        icon.className = iconClass;
        btn.replaceChildren(icon, document.createTextNode(' ' + labelText));
    }

    function applyPreset(type) {
        var p = '';
        var s = '';
        if (type === 'jira') {
            p = '/.*?(?<match>\\([A-Z]{2,10}-[0-9]{1,6}\\)).*/i';
            s = '/.*?(?<solved>Closed|Resolved).*/i';
        } else if (type === 'github') {
            p = '/.*?(?<match>#[0-9]{1,6}).*/';
            s = '/.*?(?<solved>Closed|Fixed).*/i';
        } else if (type === 'servicenow') {
            p = '/.*?(?<match>(?:INC|REQ|TASK)[0-9]{7}).*/i';
            s = '/.*?(?<solved>Resolved|Closed).*/i';
        } else if (type === 'bracket') {
            p = '/.*?\\[(?<match>[A-Za-z0-9_\\-#]+)\\].*/';
            s = '';
        }
        document.getElementById('simPattern').value = p;
        document.getElementById('histPattern').value = p;
        document.getElementById('simSolvedPattern').value = s;
    }

    // Delegated CSP-compliant listener for regex preset buttons
    document.querySelectorAll('.simulator-tab-content [data-preset]').forEach(function(item) {
        item.addEventListener('click', function(e) {
            e.preventDefault();
            applyPreset(this.getAttribute('data-preset') || '');
        });
    });

    // Handle Sample Simulation Form Submission
    var sampleForm = document.getElementById('sampleSimulatorForm');
    if (sampleForm) {
        sampleForm.addEventListener('submit', function(e) {
            e.preventDefault();
            var btn = document.getElementById('btnRunSampleTest');

            function unlockBtn() {
                if (btn) {
                    btn.disabled = false;
                    setSimulatorButtonContent(btn, 'fas fa-play me-1', simLabels.testBtn);
                }
            }

            if (btn) {
                btn.disabled = true;
                setSimulatorButtonContent(btn, 'fas fa-spinner fa-spin me-1', simLabels.testingBtn);
            }

            var payload = new FormData();
            payload.append('action', 'simulate_sample');
            payload.append('pattern', document.getElementById('simPattern').value);
            payload.append('subject', document.getElementById('simSubject').value);
            payload.append('sender', document.getElementById('simSender').value);
            payload.append('solved_pattern', document.getElementById('simSolvedPattern').value);

            var token = window.glpiCsrfToken || (document.getElementById('glpi_csrf_token') ? document.getElementById('glpi_csrf_token').value : '');
            if (token) {
                payload.append('_glpi_csrf_token', token);
            }

            var headers = {
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json'
            };
            if (token) {
                headers['X-Glpi-Csrf-Token'] = token;
            }

            fetch('{{ plugin_url }}front/simulator', {
                method: 'POST',
                headers: headers,
                body: payload
            })
            .then(function(response) {
                if (!response.ok) {
                    return response.text().then(function() {
                        var msg = (response.status === 403)
                            ? simLabels.forbidden403
                            : ('HTTP ' + response.status + ': ' + (response.statusText || 'Error'));
                        throw new Error(msg);
                    });
                }
                return response.json();
            })
            .then(function(data) {
                unlockBtn();
                if (data && data.csrf_token && window.updateGlpiCsrfToken) {
                    window.updateGlpiCsrfToken(data.csrf_token);
                }
                document.getElementById('sampleSimResult').style.display = 'block';

                function setAlertBadge(containerId, alertClass, iconClass, message) {
                    var container = document.getElementById(containerId);
                    if (!container) return;
                    var div = document.createElement('div');
                    div.className = 'alert ' + alertClass + ' py-2 mb-0';
                    var icon = document.createElement('i');
                    icon.className = iconClass + ' me-1';
                    div.appendChild(icon);
                    div.appendChild(document.createTextNode(' ' + message));
                    container.replaceChildren(div);
                }

                if (!data.success) {
                    setAlertBadge('sampleSimBadge', 'alert-danger', 'fas fa-times-circle', data.error || 'Syntax error');
                    document.getElementById('resPatternValid').textContent = 'No';
                    document.getElementById('resMatchedToken').textContent = '—';
                    document.getElementById('resTargetTickets').textContent = '—';
                    document.getElementById('resSimulatedAction').textContent = 'ERROR';
                    return;
                }

                document.getElementById('resPatternValid').textContent = 'Yes (Valid)';

                var tokenEl = document.getElementById('resMatchedToken');
                if (data.token) {
                    var code = document.createElement('code');
                    code.textContent = data.token;
                    tokenEl.replaceChildren(code);
                } else {
                    tokenEl.textContent = 'None';
                }

                var targetEl = document.getElementById('resTargetTickets');
                targetEl.replaceChildren();
                if (data.target_tickets && data.target_tickets.length > 0) {
                    data.target_tickets.forEach(function(id) {
                        var a = document.createElement('a');
                        a.href = '{{ glpi_url }}/front/ticket.form.php?id=' + encodeURIComponent(id);
                        a.target = '_blank';
                        a.className = 'badge bg-secondary-lt text-decoration-none me-1';
                        a.textContent = '#' + id;
                        targetEl.appendChild(a);
                    });
                } else {
                    targetEl.textContent = 'None found in pool';
                }

                document.getElementById('resSimulatedAction').textContent = data.simulated_action;

                if (data.collision) {
                    setAlertBadge('sampleSimBadge', 'alert-danger', 'fas fa-exclamation-triangle', 'Collision: multiple tickets matched. Action would be aborted.');
                } else if (data.matched) {
                    setAlertBadge('sampleSimBadge', 'alert-success', 'fas fa-check-circle', 'Pattern matched successfully. Simulated action: ' + (data.simulated_action || ''));
                } else {
                    setAlertBadge('sampleSimBadge', 'alert-secondary', 'fas fa-info-circle', 'Pattern did not match this subject (normal non-match).');
                }
            })
            .catch(function(err) {
                unlockBtn();
                document.getElementById('sampleSimResult').style.display = 'block';
                var container = document.getElementById('sampleSimBadge');
                if (container) {
                    var div = document.createElement('div');
                    div.className = 'alert alert-danger py-2 mb-0';
                    var icon = document.createElement('i');
                    icon.className = 'fas fa-times-circle me-1';
                    div.appendChild(icon);
                    div.appendChild(document.createTextNode(' ' + err.message));
                    container.replaceChildren(div);
                }
            });
        });
    }

    // Handle Historical Simulation Form Submission
    var histForm = document.getElementById('historicalSimulatorForm');
    if (histForm) {
        histForm.addEventListener('submit', function(e) {
            e.preventDefault();
            var btn = document.getElementById('btnRunHistTest');

            function unlockBtn() {
                if (btn) {
                    btn.disabled = false;
                    setSimulatorButtonContent(btn, 'fas fa-search me-1', simLabels.scanBtn);
                }
            }

            if (btn) {
                btn.disabled = true;
                setSimulatorButtonContent(btn, 'fas fa-spinner fa-spin me-1', simLabels.scanningBtn);
            }

            var payload = new FormData();
            payload.append('action', 'simulate_historical');
            payload.append('pattern', document.getElementById('histPattern').value);
            payload.append('limit', document.getElementById('histLimit').value);

            var token = window.glpiCsrfToken || (document.getElementById('glpi_csrf_token') ? document.getElementById('glpi_csrf_token').value : '');
            if (token) {
                payload.append('_glpi_csrf_token', token);
            }

            var headers = {
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json'
            };
            if (token) {
                headers['X-Glpi-Csrf-Token'] = token;
            }

            fetch('{{ plugin_url }}front/simulator', {
                method: 'POST',
                headers: headers,
                body: payload
            })
            .then(function(response) {
                if (!response.ok) {
                    return response.text().then(function() {
                        var msg = (response.status === 403)
                            ? simLabels.forbidden403
                            : ('HTTP ' + response.status + ': ' + (response.statusText || 'Error'));
                        throw new Error(msg);
                    });
                }
                return response.json();
            })
            .then(function(data) {
                unlockBtn();
                if (data && data.csrf_token && window.updateGlpiCsrfToken) {
                    window.updateGlpiCsrfToken(data.csrf_token);
                }
                document.getElementById('historicalSimResult').style.display = 'block';

                var tbody = document.querySelector('#histMatchesTable tbody');
                tbody.replaceChildren();

                if (!data.success) {
                    var errRow = document.createElement('tr');
                    var errCell = document.createElement('td');
                    errCell.colSpan = 4;
                    errCell.className = 'text-center text-danger py-3';
                    errCell.textContent = 'Simulation error: ' + (data.error || 'Unknown error');
                    errRow.appendChild(errCell);
                    tbody.appendChild(errRow);
                    return;
                }

                document.getElementById('histScannedCount').textContent = data.total_scanned;
                document.getElementById('histMatchedCount').textContent = data.total_matched;
                document.getElementById('histCollisionCount').textContent = data.collisions;

                if (data.matches && data.matches.length > 0) {
                    data.matches.forEach(function(m) {
                        var tr = document.createElement('tr');

                        var tdId = document.createElement('td');
                        var aLink = document.createElement('a');
                        aLink.href = '{{ glpi_url }}/front/ticket.form.php?id=' + encodeURIComponent(m.ticket_id);
                        aLink.target = '_blank';
                        aLink.className = 'fw-semibold text-decoration-none';
                        aLink.textContent = '#' + m.ticket_id;
                        tdId.appendChild(aLink);

                        var tdName = document.createElement('td');
                        tdName.className = 'small text-truncate';
                        tdName.style.maxWidth = '200px';
                        tdName.setAttribute('title', m.ticket_name || '');
                        tdName.textContent = m.ticket_name || '';

                        var tdToken = document.createElement('td');
                        var code = document.createElement('code');
                        code.textContent = m.token || '';
                        tdToken.appendChild(code);

                        var tdCol = document.createElement('td');
                        var colBadge = document.createElement('span');
                        colBadge.className = m.is_collision ? 'badge bg-danger-lt' : 'badge bg-green-lt';
                        colBadge.textContent = m.is_collision ? 'Collision' : 'Unique';
                        tdCol.appendChild(colBadge);

                        tr.appendChild(tdId);
                        tr.appendChild(tdName);
                        tr.appendChild(tdToken);
                        tr.appendChild(tdCol);
                        tbody.appendChild(tr);
                    });
                } else {
                    var emptyRow = document.createElement('tr');
                    var emptyCell = document.createElement('td');
                    emptyCell.colSpan = 4;
                    emptyCell.className = 'text-center text-muted py-3';
                    emptyCell.textContent = 'No matching tickets found in the scanned range.';
                    emptyRow.appendChild(emptyCell);
                    tbody.appendChild(emptyRow);
                }
            })
            .catch(function(err) {
                unlockBtn();
                document.getElementById('historicalSimResult').style.display = 'block';
                var tbody = document.querySelector('#histMatchesTable tbody');
                if (tbody) {
                    var errRow = document.createElement('tr');
                    var errCell = document.createElement('td');
                    errCell.colSpan = 4;
                    errCell.className = 'text-center text-danger py-3';
                    errCell.textContent = 'Batch simulation error: ' + err.message;
                    errRow.appendChild(errCell);
                    tbody.replaceChildren(errRow);
                }
            });
        });
    }
})();
</script>
