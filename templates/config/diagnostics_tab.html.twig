<div class="diagnostics-tab-content">
    <div class="card">
        <div class="card-header">
            <h5 class="card-title mb-0">
                <i class="fas fa-stethoscope text-muted me-2"></i>{{ __('Environment sanity checks', 'ticketfilter') }}
            </h5>
        </div>
        <div class="card-body">
            <ul class="list-group list-group-flush mb-3">
                {% if sanity.checks is defined %}
                    {% for check in sanity.checks %}
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span>{{ check.message }}</span>
                        {% if check.passed %}
                            <span class="badge bg-green-lt">{{ __('Pass', 'ticketfilter') }}</span>
                        {% else %}
                            <span class="badge bg-danger-lt">{{ __('Fail', 'ticketfilter') }}</span>
                        {% endif %}
                    </li>
                    {% endfor %}
                {% else %}
                    {% for msg in sanity.messages %}
                    <li class="list-group-item d-flex align-items-center px-0">
                        {{ msg }}
                    </li>
                    {% endfor %}
                {% endif %}
            </ul>

            <div class="alert {% if sanity.status %}alert-secondary{% else %}alert-danger{% endif %} mb-0 py-2">
                {% if sanity.status %}
                    <i class="fas fa-check-circle me-1 text-success"></i>{{ __('All system diagnostics passed successfully.', 'ticketfilter') }}
                {% else %}
                    <i class="fas fa-exclamation-circle me-1 text-danger"></i>{{ __('One or more diagnostic checks failed. Please check installation.', 'ticketfilter') }}
                {% endif %}
            </div>
        </div>
    </div>
</div>
